generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  stocks       Stock[]
}

model Stock {
  id        String   @id @default(cuid())
  symbol    String
  name      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  records   Record[]
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
}

// สถิติ 1 แถว = 1 วัน: ค่าดัชนี + ค่าเปลี่ยนแปลง (มีเครื่องหมาย +/-) ตอนเปิดและตอนปิด
// เช่น เปิด 74,781.76 (-120.83) ปิด 74,900.10 (+2.51)
model Record {
  id          String   @id @default(cuid())
  stockId     String
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  date        DateTime
  openValue   Float    // ค่าดัชนีตอนเปิด
  openChange  Float    // เปลี่ยนแปลงตอนเปิด (เทียบปิดวันก่อน) มีเครื่องหมาย
  closeValue  Float?   // ค่าดัชนีตอนปิด (กรอกทีหลังได้ — เช้ากรอกเปิด เย็นเติมปิด)
  closeChange Float?   // เปลี่ยนแปลงตอนปิด (เทียบปิดวันก่อน) มีเครื่องหมาย
  note        String?
  liveValue   Float?   // ค่าดัชนีที่อ่านระหว่างวัน (ใช้ฟันทิศทางสด) — บันทึกครั้งเดียวต่อวัน
  liveAt      DateTime? // เวลาที่อ่านค่านั้น
  /** เลขฟันที่ล็อกไว้ตอนโชว์ครั้งแรกก่อนผลปิด เช่น "4-2" — รายงานนับเฉพาะงวดที่มีเลขล็อก = ผลจริง (ผู้ใช้แทงจริง ต.ค. 69) · แก้ราคาเปิดก่อนปิด → ล้างแล้วล็อกใหม่ */
  pick        String?
  /** เลขเจาะ 2 ชุดที่ล็อกพร้อมเลขฟัน (JSON string[][]) */
  drill       String?
  createdAt   DateTime @default(now())

  @@index([stockId, date])
}

// ผลหุ้น VIP (stocks-vip.com): 1 แถว = 1 ตลาด × 1 วัน × 1 รอบ — บน 3 หลัก (หลักหน่วย + ทศนิยม 2 ตำแหน่งของราคาปิด) ล่าง 2 หลัก (ทศนิยมของ ปิด − เปิด)
// open/close/diff มีเฉพาะวันที่ดึงจากราคาสดได้ (endpoint ประวัติให้แค่เลขผล)
model VipResult {
  id        String   @id @default(cuid())
  userId    String
  market    String   // in | jp | cn | hk | tw | kr
  date      DateTime
  round     Int      // 1 = เช้า, 2 = เย็น (ตลาดที่มีรอบเดียวใช้ 2)
  top       String   // "429"
  bottom    String   // "32"
  open      Float?
  close     Float?
  diff      Float?
  source    String   @default("web") // web | manual
  /** เลขที่ฟันไว้ตอนนั้น (ล็อกครั้งแรก ไม่เขียนทับ) เช่น "9-6" — เพื่อให้ผลย้อนหลังตรงกับที่ผู้ใช้เห็นจริง ไม่เปลี่ยนตามสูตรที่แก้ทีหลัง */
  pick      String?
  /** เลขเจาะ 2 ชุดที่ล็อกพร้อมเลขฟัน (JSON ของ VipDrillSet[]) — รายงานใช้ชุดนี้ ไม่คิดใหม่ตามสูตรที่แก้ทีหลัง (ผู้ใช้แทงเงินจริง 13 ต.ค. 69) */
  drill     String?
  createdAt DateTime @default(now())

  @@unique([userId, market, date, round])
  @@index([userId, market, date])
}

/// ราคารายวันของดัชนี (หุ้นปกติ) ไว้ทำสถิติ % → เลขที่ออก — เก็บถาวร เพราะ Yahoo ให้ปิดภาคเช้าย้อนหลังแค่ ~2 ปีแบบเลื่อน (ผู้ใช้ขอ 14 ต.ค. 69)
/// key = nk-am | nk-pm | cn-am | cn-pm | hk-am | hk-pm | sx | dj | eg · close = ราคาผลของรอบนั้น · prevClose = ปิดวันก่อน
model IndexDay {
  id        String   @id @default(cuid())
  key       String
  date      String
  prevClose Float
  open      Float?
  close     Float
  createdAt DateTime @default(now())

  @@unique([key, date])
  @@index([key, date])
}

/// แท่ง 1 ชั่วโมงของ BTCUSDT ฟิวเจอร์ (Binance) — เฉพาะแท่งที่ปิดแล้ว · ข้อมูลตลาด ใช้ร่วมทุกผู้ใช้ (ผู้ใช้ขอ 17 ต.ค. 69)
model BtcBar {
  openTime DateTime @id
  open     Float
  high     Float
  low      Float
  close    Float
}

/// สัญญาณ Long ของ BTC ที่ล็อกไว้ (เริ่มนับผลจริงตั้งแต่วันเปิดเมนู) — drop = เกณฑ์ลง 24 ชม. ที่ใช้ (3 | 5 | 7 %)
model BtcSignal {
  id        String   @id @default(cuid())
  userId    String
  drop      Int
  mode      String   @default("close") // close = เข้าที่ราคาปิดแท่ง · limit = limit −1% รอ 2 ชม. ไม่ match = ข้าม · range = limit ใต้จุดต่ำสุด 24 ชม. (drop = ระดับ ×10)
  entryAt   DateTime // เวลาเข้า = ปิดแท่งที่ลงถึงเกณฑ์ (limit = ปิดแท่งที่ match)
  entry     Float
  exitAt    DateTime // เข้า + 12 ชม.
  exit      Float?   // ราคาออก (ว่าง = ยังถืออยู่)
  createdAt DateTime @default(now())

  @@unique([userId, drop, mode, entryAt])
}

/// ข้อมูลฟิวเจอร์รายชั่วโมงที่ Binance เก็บย้อนหลังแค่ 30 วัน — เก็บสะสมไว้หาสัญญาณ Short ภายหลัง (ผู้ใช้ขอ 17 ต.ค. 69) · ยังไม่ใช้คิดสัญญาณ
model BtcFlow {
  time       DateTime @id // timestamp ของ Binance (UTC ต้นชั่วโมง)
  oi         Float?   // open interest (BTC)
  oiValue    Float?   // open interest (USDT)
  lsAccount  Float?   // long/short ratio บัญชีทั้งตลาด
  lsTop      Float?   // long/short ratio ขนาดสถานะของ top trader
  takerRatio Float?   // taker buy/sell volume ratio
}

/// เลขไหลที่ผู้ใช้ทายไว้ล่วงหน้า (ผู้ใช้ขอ 22 ต.ค. 69) — 2 ตัวต่อวันต่อวิธี · แก้/ลบได้ถึงก่อนรอบแรกของวัน (นิเช้า 09:30 ไทย) แล้วล็อก
/// นับผลจากผลจริงของวันนั้น เพื่อดูว่าวิธีไหนทายเลขไหลได้จริงหรือแค่บังเอิญ
model FlowGuess {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD วันที่ทาย
  method    String   // ชื่อวิธี เช่น "คิดเอง" / "กลุ่ม A"
  digits    String   // "34"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, method])
  @@index([userId, date])
}
